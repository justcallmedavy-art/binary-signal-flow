# ── Meridian Terminal backend configuration ─────────────────────────────────
# Copy to `.env` (or export in your process manager) and fill in. These values
# are read ONLY by server/server.js — they are never sent to the browser.
#
# The front end works with no configuration at all: Binance and CoinGecko are
# public and need no key, and the built-in simulator covers every instrument
# offline. This file exists for keyed providers.

# Which keyed provider to use: twelvedata | polygon | none
DATA_PROVIDER=none

# Credentials for the selected provider (only the selected one is required)
TWELVEDATA_API_KEY=
POLYGON_API_KEY=

# Server
PORT=8787
CACHE_TTL_MS=20000
RATE_LIMIT_PER_MIN=90
MAX_BARS=1000
